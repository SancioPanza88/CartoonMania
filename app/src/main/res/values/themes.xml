<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/CmAnim.Activity</item>
    </style>

    <style name="CmAnim.Activity" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cm_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/cm_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/cm_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/cm_close_exit</item>
    </style>

    <style name="PlayerTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
