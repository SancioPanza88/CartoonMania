<?xml version="1.0" encoding="utf-8"?>
<!-- Icona: sfondo pieno opaco fino ai bordi (niente trasparenze = niente
     bordi bianchi quando il launcher la incornicia) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#8B5CF6"
                android:centerColor="#5B3DF0"
                android:endColor="#2A1B6B" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_fg" />
</layer-list>
